# Copie ce fichier en `.env` et remplis la vraie valeur.
# `.env` est ignore par git : ta cle ne partira jamais sur GitHub.

# Cle de TON service, elle protege /chat. Genere-la avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=remplace-moi

# Cle de l'API Mistral (console.mistral.ai)
MISTRAL_API_KEY=remplace-moi
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
REQUEST_TIMEOUT_SECONDS=90

# Base vectorielle. En local, docker compose l'expose sur 5433.
# En production, l'URL fournie par ton hebergeur Postgres.
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
